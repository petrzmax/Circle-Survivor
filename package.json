{
  "name": "circle-survivor",
  "version": "1.0.0",
  "description": "Circle Survivor is a Brotato-like survival game, vibe coded with Copilot.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write src/ scripts/",
    "balance:export": "tsx scripts/balance-export.ts",
    "balance:import": "tsx scripts/balance-import.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrzmax/Circle-Survivor.git"
  },
  "keywords": [],
  "author": "Artur Petrzak",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/petrzmax/Circle-Survivor/issues"
  },
  "homepage": "https://github.com/petrzmax/Circle-Survivor#readme",
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/ui": "^4.1.2",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "eslint": "^10.1.0",
    "exceljs": "^4.4.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "koota": "^0.6.5",
    "nipplejs": "^1.0.1",
    "preact": "^10.29.1",
    "react-hot-toast": "^2.6.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
